# ------------------------------------------------------------------
# Copy this file to .env.local and fill in the values that apply.
# The site builds and runs without any of these variables set — they
# enable production integrations (booking storage, email, analytics).
# ------------------------------------------------------------------

# Supabase — booking storage
# Create a project at https://supabase.com, run supabase/migrations/0001_bookings.sql,
# then copy these from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — email notifications
# Sign up at https://resend.com. Use a verified sending domain.
RESEND_API_KEY=
# The clinic's inbox that should receive booking notifications
CLINIC_NOTIFICATION_EMAIL=
# Optional — the "from" address used by Resend (must be a verified sender)
CLINIC_FROM_EMAIL=appointments@drpradeepsahoo.com

# Analytics (optional)
# Plausible — a lightweight, privacy-friendly tracker.
# Set to the domain you registered at Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Microsoft Clarity — free heatmaps + session recordings.
# The project ID from clarity.microsoft.com.
NEXT_PUBLIC_CLARITY_ID=
